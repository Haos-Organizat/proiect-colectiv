# Backend Configuration
FLASK_APP=backend/api/index.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
# Signs the login session cookie. Any long random string locally; a real secret in production.
SECRET_KEY=

# Supabase Local Development (values printed by `npx supabase status` after `just start-db`)
SUPABASE_URL=http://127.0.0.1:54321
# The backend uses the service_role key ("Secret key" in `supabase status`). It bypasses
# row-level security, so it must only ever live on the server, never in frontend code.
SUPABASE_KEY=
# Same key, used by backend/tests/test_auth_integration.py.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
