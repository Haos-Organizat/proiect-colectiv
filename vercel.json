{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/backend/api/index.py" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "builds": [
    { "src": "frontend/package.json", "use": "@vercel/vite" },
    { "src": "backend/api/index.py", "use": "@vercel/python" }
  ]
}
