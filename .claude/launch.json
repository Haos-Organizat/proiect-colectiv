{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--project",
        "backend",
        "python",
        "-m",
        "flask",
        "--app",
        "backend/api/index.py",
        "run",
        "--port",
        "5000"
      ],
      "port": 5000
    },
    {
      "name": "brand",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "5180", "--directory", "design/brand"],
      "port": 5180
    }
  ]
}
